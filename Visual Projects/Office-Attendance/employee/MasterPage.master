<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterPage.master.cs" Inherits="MasterPage" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes" />
    <title>OfficeTrack - Employee Attendance Portal</title>

    <!-- Google Fonts & Bootstrap 5 & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <!-- Employee Panel Custom CSS -->
    <link rel="stylesheet" href="Assets/css/employee.css" />

    <!-- Head & Stylesheet PlaceHolders -->
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
    <asp:ContentPlaceHolder ID="StylesheetsContent" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div class="app-wrapper">
            <!-- DESKTOP SIDEBAR -->
            <aside class="emp-sidebar" aria-label="Employee Navigation">
                <div class="emp-sidebar-header">
                    <a href="dashboard.aspx" class="brand-link">
                        <div class="brand-icon">
                            <i class="bi bi-fingerprint"></i>
                        </div>
                        <div>
                            <span>OfficeTrack</span>
                            <span class="badge bg-primary bg-opacity-25 text-white ms-1" style="font-size: 0.65rem !important;">STAFF</span>
                        </div>
                    </a>
                </div>

                <div class="emp-sidebar-nav-container">
                    <div class="nav-section-title">Main</div>
                    <ul class="emp-sidebar-nav">
                        <li class="nav-item">
                            <a href="dashboard.aspx" class="nav-link">
                                <i class="bi bi-grid-1x2-fill"></i>
                                <span>Dashboard</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="ScanQR.aspx" class="nav-link">
                                <i class="bi bi-qr-code-scan"></i>
                                <span>Scan QR</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="MyAttendance.aspx" class="nav-link">
                                <i class="bi bi-calendar-check-fill"></i>
                                <span>My Attendance</span>
                            </a>
                        </li>
                    </ul>

                    <div class="nav-section-title">Services</div>
                    <ul class="emp-sidebar-nav">
                        <li class="nav-item">
                            <a href="MyLeaves.aspx" class="nav-link">
                                <i class="bi bi-calendar-week-fill"></i>
                                <span>My Leaves</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="Holidays.aspx" class="nav-link">
                                <i class="bi bi-calendar-heart-fill"></i>
                                <span>Holidays & Offs</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="Notifications.aspx" class="nav-link">
                                <i class="bi bi-bell-fill"></i>
                                <span>Notifications</span>
                            </a>
                        </li>
                    </ul>

                    <div class="nav-section-title">Account</div>
                    <ul class="emp-sidebar-nav">
                        <li class="nav-item">
                            <a href="MyProfile.aspx" class="nav-link">
                                <i class="bi bi-person-circle"></i>
                                <span>My Profile</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- SIDEBAR FOOTER (LOGGED IN EMPLOYEE) -->
                <div class="emp-sidebar-footer">
                    <div class="emp-mini-card">
                        <div class="emp-avatar">VM</div>
                        <div class="emp-meta">
                            <div class="name">Vikram Malhotra</div>
                            <div class="role">OT-1008 • Sr. Engineer</div>
                        </div>
                        <a href="Login.aspx" class="btn btn-sm btn-link text-white-50 p-1" title="Sign Out">
                            <i class="bi bi-box-arrow-right fs-5"></i>
                        </a>
                    </div>
                </div>
            </aside>

            <!-- MAIN CONTENT CONTAINER -->
            <div class="emp-main">
                <!-- TOP NAVBAR -->
                <header class="emp-topbar">
                    <div class="emp-topbar-left">
                        <!-- Mobile Brand Logo -->
                        <a href="dashboard.aspx" class="brand-link d-lg-none text-navy">
                            <div class="brand-icon" style="width:32px; height:32px; font-size:1rem;">
                                <i class="bi bi-fingerprint"></i>
                            </div>
                            <span class="fs-6 fw-bold text-navy">OfficeTrack</span>
                        </a>

                        <!-- Desktop Date & Clock -->
                        <div class="d-none d-lg-flex align-items-center gap-2 text-muted small">
                            <i class="bi bi-calendar3 text-navy"></i>
                            <span class="fw-semibold text-dark">Thursday, Oct 29, 2026</span>
                            <span>•</span>
                            <span class="badge bg-light text-dark border live-time-display font-monospace">10:45:00 AM</span>
                            <span>•</span>
                            <span class="badge-status badge-active"><i class="bi bi-circle-fill" style="font-size:0.5rem;"></i> Shift: 10:00 AM - 06:00 PM</span>
                        </div>
                    </div>

                    <div class="emp-topbar-right">
                        <!-- Desktop Scan QR Shortcut -->
                        <a href="ScanQR.aspx" class="btn btn-sm btn-navy d-none d-md-inline-flex">
                            <i class="bi bi-qr-code-scan"></i>
                            <span>Scan QR Attendance</span>
                        </a>

                        <!-- Notifications Bell Icon -->
                        <a href="Notifications.aspx" class="topbar-btn" title="Notifications">
                            <i class="bi bi-bell"></i>
                            <span class="badge-dot"></span>
                        </a>

                        <!-- Employee Profile Pill / Dropdown -->
                        <div class="dropdown">
                            <button class="btn p-0 border-0 d-flex align-items-center gap-2" type="button" id="empDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="emp-avatar" style="width: 34px; height: 34px; background: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd;">
                                    VM
                                </div>
                                <span class="d-none d-md-inline text-navy fw-semibold small">Vikram M.</span>
                                <i class="bi bi-chevron-down text-muted small ms-1"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border" aria-labelledby="empDropdown">
                                <li>
                                    <div class="px-3 py-2 border-bottom">
                                        <div class="fw-bold text-navy small">Vikram Malhotra</div>
                                        <div class="text-muted" style="font-size: 0.72rem;">OT-1008 • Engineering</div>
                                    </div>
                                </li>
                                <li><a class="dropdown-item py-2" href="MyProfile.aspx"><i class="bi bi-person me-2"></i> My Profile</a></li>
                                <li><a class="dropdown-item py-2" href="MyLeaves.aspx"><i class="bi bi-calendar-week me-2"></i> Leave Status</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item py-2 text-danger" href="Login.aspx"><i class="bi bi-box-arrow-right me-2"></i> Log Out</a></li>
                            </ul>
                        </div>
                    </div>
                </header>

                <!-- MAIN ASP.NET CONTENT BODY -->
                <main id="main-content" class="page-content-wrapper" role="main">
                    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                    </asp:ContentPlaceHolder>
                </main>
            </div>
        </div>

        <!-- MOBILE FIXED BOTTOM NAVIGATION BAR -->
        <nav class="mobile-bottom-nav" aria-label="Mobile Navigation">
            <a href="dashboard.aspx" class="bottom-nav-item">
                <i class="bi bi-grid-1x2"></i>
                <span>Home</span>
            </a>
            <a href="MyAttendance.aspx" class="bottom-nav-item">
                <i class="bi bi-calendar-check"></i>
                <span>History</span>
            </a>
            <a href="ScanQR.aspx" class="bottom-nav-item bottom-nav-center-scan" title="Scan QR Code">
                <i class="bi bi-qr-code-scan"></i>
            </a>
            <a href="MyProfile.aspx" class="bottom-nav-item">
                <i class="bi bi-person"></i>
                <span>Profile</span>
            </a>
            <button type="button" class="bottom-nav-item border-0 bg-transparent" data-bs-toggle="offcanvas" data-bs-target="#mobileMoreOffcanvas" aria-controls="mobileMoreOffcanvas">
                <i class="bi bi-three-dots"></i>
                <span>More</span>
            </button>
        </nav>

        <!-- MOBILE "MORE" OFFCANVAS / BOTTOM DRAWER -->
        <div class="offcanvas offcanvas-bottom rounded-top-4" tabindex="-1" id="mobileMoreOffcanvas" aria-labelledby="mobileMoreLabel" style="height: auto; max-height: 80vh;">
            <div class="offcanvas-header border-bottom py-3">
                <div class="d-flex align-items-center gap-2">
                    <div class="emp-avatar" style="width: 36px; height: 36px; background: #e0f2fe; color: #0369a1;">VM</div>
                    <div>
                        <div class="fw-bold text-navy small">Vikram Malhotra</div>
                        <div class="text-muted" style="font-size: 0.72rem;">OT-1008 • Engineering</div>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body p-3">
                <div class="list-group list-group-flush mb-3">
                    <a href="MyLeaves.aspx" class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3 border-0 rounded-3 mb-1">
                        <i class="bi bi-calendar-week text-primary fs-5"></i>
                        <div class="flex-grow-1">
                            <div class="fw-semibold text-navy small">My Leaves & Balance</div>
                            <div class="text-muted" style="font-size: 0.72rem;">Apply for leave & check quota</div>
                        </div>
                        <i class="bi bi-chevron-right text-muted small"></i>
                    </a>
                    <a href="Holidays.aspx" class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3 border-0 rounded-3 mb-1">
                        <i class="bi bi-calendar-heart text-danger fs-5"></i>
                        <div class="flex-grow-1">
                            <div class="fw-semibold text-navy small">Holidays & Weekly Off</div>
                            <div class="text-muted" style="font-size: 0.72rem;">2026 Official non-working days</div>
                        </div>
                        <i class="bi bi-chevron-right text-muted small"></i>
                    </a>
                    <a href="Notifications.aspx" class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3 border-0 rounded-3 mb-1">
                        <i class="bi bi-bell text-warning fs-5"></i>
                        <div class="flex-grow-1">
                            <div class="fw-semibold text-navy small">Notifications & Notices</div>
                            <div class="text-muted" style="font-size: 0.72rem;">Attendance reminders and alerts</div>
                        </div>
                        <span class="badge bg-danger rounded-pill">3</span>
                    </a>
                    <a href="MyProfile.aspx" class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3 border-0 rounded-3 mb-1">
                        <i class="bi bi-shield-lock text-success fs-5"></i>
                        <div class="flex-grow-1">
                            <div class="fw-semibold text-navy small">Security & Password</div>
                            <div class="text-muted" style="font-size: 0.72rem;">Change credentials</div>
                        </div>
                        <i class="bi bi-chevron-right text-muted small"></i>
                    </a>
                </div>

                <div class="pt-2 border-top">
                    <a href="Login.aspx" class="btn btn-outline-danger w-100 py-2">
                        <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                    </a>
                </div>
            </div>
        </div>
    </form>

    <!-- Bootstrap 5 Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- OfficeTrack Employee Vanilla JS -->
    <script src="Assets/js/employee.js"></script>

    <!-- Script PlaceHolder for Page Specific Scripts -->
    <asp:ContentPlaceHolder ID="ScriptsContent" runat="server">
    </asp:ContentPlaceHolder>
</body>
</html>
